# ─── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_PREFIX=v1

# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection (never use root credentials for the app role)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=vbl_db
DATABASE_USER=vbl_app
DATABASE_PASSWORD=PLACEHOLDER_DB_PASSWORD
DATABASE_SSL=false

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=PLACEHOLDER_JWT_ACCESS_SECRET
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=PLACEHOLDER_JWT_REFRESH_SECRET
JWT_REFRESH_EXPIRES_IN=30d

# ─── verify.et ────────────────────────────────────────────────────────────────
# NEVER commit a real key. Store in a secrets manager in production.
# Key must have only verification:write and verification:read permissions.
# Use a separate key per environment (dev / staging / prod).
VERIFY_ET_API_KEY=PLACEHOLDER_VERIFY_ET_API_KEY
VERIFY_ET_BASE_URL=https://verify.et
VERIFY_ET_TIMEOUT_MS=10000

# verify.et webhook HMAC secret (starts with whsec_...)
VERIFY_ET_WEBHOOK_SECRET=PLACEHOLDER_whsec_WEBHOOK_SECRET

# ─── Organisation receiving accounts ──────────────────────────────────────────
# The account(s) members should pay to. Sent as settlementAccount to verify.et.
# Example: phone number for Telebirr, account number for CBE
# These are loaded from the DB (org_receiving_accounts table).
# Seed them via migration, not here.

# ─── Feature flags ────────────────────────────────────────────────────────────
# Set to true to enable receipt image upload (costs image credits)
FEATURE_IMAGE_VERIFICATION=false

# ─── Caddy / Server ───────────────────────────────────────────────────────────
# The public domain the server is reachable on (needed for Let's Encrypt + webhooks)
PUBLIC_DOMAIN=savethegeneration.com.et

# ─── Alerting ─────────────────────────────────────────────────────────────────
# Telegram bot for ops alerts (low credits, errors, etc.)
TELEGRAM_BOT_TOKEN=PLACEHOLDER_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=PLACEHOLDER_TELEGRAM_CHAT_ID

# ─── Firebase Admin SDK ───────────────────────────────────────────────────────
# Path to service account JSON (outside web root, mode 600)
FIREBASE_SERVICE_ACCOUNT_PATH=PLACEHOLDER_/run/secrets/firebase-service-account.json

# ─── Backup ───────────────────────────────────────────────────────────────────
# Encryption key for nightly pg_dump (age public key)
BACKUP_AGE_RECIPIENT=PLACEHOLDER_AGE_PUBLIC_KEY
BACKUP_DESTINATION=PLACEHOLDER_rclone_remote:bucket/vbl-backups
